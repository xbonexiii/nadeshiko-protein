{% liquid
  assign has_custom_video = false
  if section.settings.video != blank
    assign has_custom_video = true
  endif
%}

<section
  class="nadeshiko-concept-video"
  style="
    --concept-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --concept-height-desktop: {{ section.settings.height_desktop }}px;
    --concept-height-mobile: {{ section.settings.height_mobile }}px;
    --concept-heading-size: {{ section.settings.heading_size }}px;
  "
  aria-label="{{ section.settings.heading | escape }}"
>
  <div class="nadeshiko-concept-video__media">
    {% if has_custom_video %}
      {{
        section.settings.video
        | video_tag:
          autoplay: true,
          loop: true,
          muted: true,
          controls: false,
          playsinline: true,
          preload: 'metadata',
          class: 'nadeshiko-concept-video__video'
      }}
    {% else %}
      <video
        class="nadeshiko-concept-video__video"
        autoplay
        loop
        muted
        playsinline
        preload="metadata"
      >
        <source src="{{ 'nadeshiko-concept.mp4' | asset_url }}" type="video/mp4">
      </video>
    {% endif %}
  </div>

  <div class="nadeshiko-concept-video__overlay"></div>
  <div class="nadeshiko-concept-video__content page-width">
    {% if section.settings.eyebrow != blank %}
      <p class="nadeshiko-concept-video__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    <h2 class="nadeshiko-concept-video__heading">{{ section.settings.heading | escape }}</h2>
  </div>
</section>

{% stylesheet %}
  .nadeshiko-concept-video {
    position: relative;
    min-height: var(--concept-height-desktop);
    overflow: hidden;
    display: grid;
    place-items: center;
    background: #222;
    color: #fff;
  }

  .nadeshiko-concept-video__media,
  .nadeshiko-concept-video__overlay {
    position: absolute;
    inset: 0;
  }

  .nadeshiko-concept-video__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .nadeshiko-concept-video__overlay {
    z-index: 1;
    background: rgb(0 0 0 / var(--concept-overlay-opacity));
  }

  .nadeshiko-concept-video__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding-block: 48px;
    text-align: center;
  }

  .nadeshiko-concept-video__eyebrow {
    margin: 0 0 12px;
    font-size: 12px;
    letter-spacing: 0.22em;
  }

  .nadeshiko-concept-video__heading {
    margin: 0;
    color: inherit;
    font-family: var(--font-heading--family);
    font-size: clamp(24px, var(--concept-heading-size), 52px);
    font-weight: 400;
    line-height: 1.4;
    letter-spacing: 0.12em;
    text-wrap: balance;
  }

  @media screen and (max-width: 749px) {
    .nadeshiko-concept-video {
      min-height: var(--concept-height-mobile);
    }

    .nadeshiko-concept-video__heading {
      font-size: 25px;
      letter-spacing: 0.08em;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "コンセプトムービー",
  "class": "section-wrapper",
  "enabled_on": {
    "groups": ["footer"]
  },
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "動画",
      "info": "未設定の場合は初期登録済みのコンセプトムービーを表示します。"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "小見出し",
      "default": "NADESHIKO PROTEIN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "見出し",
      "default": "明日もっといい私になる"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "黒い背景の濃さ",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 30
    },
    {
      "type": "range",
      "id": "height_desktop",
      "label": "PCの高さ",
      "min": 320,
      "max": 800,
      "step": 20,
      "unit": "px",
      "default": 560
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "スマホの高さ",
      "min": 300,
      "max": 700,
      "step": 20,
      "unit": "px",
      "default": 480
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "PCの文字サイズ",
      "min": 24,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 38
    }
  ],
  "presets": [
    {
      "name": "コンセプトムービー"
    }
  ]
}
{% endschema %}
